               RowBox[{"\[Pi]", " ", 
                RowBox[{"w2", "^", "2"}]}], 
               RowBox[{"\[Lambda]", " ", "f2"}]], ")"}]}]]}]}], ";"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"waist", "[", 
           RowBox[{"z_", ",", "wa_"}], "]"}], ":=", 
          RowBox[{"wa", "*", 
           SqrtBox[
            RowBox[{"1", "+", 
             RowBox[{
              RowBox[{"(", 
               FractionBox["z", 
                FractionBox[
                 RowBox[{"\[Pi]", " ", 
                  RowBox[{"wa", "^", "2"}]}], "\[Lambda]"]], ")"}], "^", 
              "2"}]}]]}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"ans", "=", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"1", "-", 
               FractionBox["sol", "f1"]}], ")"}], "^", "2"}], "+", 
            RowBox[{
             RowBox[{"(", 
              FractionBox[
               RowBox[{"\[Pi]", " ", 
                RowBox[{"w0", "^", "2"}]}], 
               RowBox[{"\[Lambda]", " ", "f1"}]], ")"}], "^", "2"}]}], "\[Equal]", 
           RowBox[{
            FractionBox["1", 
             RowBox[{"m", "^", "2"}]], 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 

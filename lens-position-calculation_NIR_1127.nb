Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Given", " ", "input", " ", "beam"}], ",", " ", 
    RowBox[{
    "desired", " ", "beam", " ", "waist", " ", "and", " ", "two", " ", 
     "focal", " ", "lengths"}], ",", " ", 
    RowBox[{"solve", " ", "for", " ", "object", " ", "and", " ", "image", " ", 
     RowBox[{"position", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"TwoLensFixf", " ", "[", 
     RowBox[{"\[Lambda]_", ",", "r0_", ",", "m_", ",", "f1_", ",", "f2_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "sx2", ",", "sy2", ",", "w1", ",", "w2", ",", "waist", ",", "i", ",", 
        "ans", ",", "sol", ",", 
        RowBox[{"res", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"w2", "=", 
        RowBox[{"m", "*", "r0"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{"m", " ", "is", " ", 
         RowBox[{"magnification", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"w1", "[", "sy2_", "]"}], ":=", 
        RowBox[{"w2", "/", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox["sy2", "f2"]}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[Pi]", " ", 
               RowBox[{"w2", "^", "2"}]}], 
              RowBox[{"\[Lambda]", " ", "f2"}]], ")"}], "^", "2"}]}]]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"waist", "[", 
         RowBox[{"z_", ",", "w0_"}], "]"}], ":=", 
        RowBox[{"w0", "*", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"(", 
             FractionBox["z", 
              FractionBox[
               RowBox[{"\[Pi]", " ", 
                RowBox[{"w0", "^", "2"}]}], "\[Lambda]"]], ")"}], "^", 
            "2"}]}]]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"waist", "[", 
           RowBox[{"f1", ",", 
            RowBox[{"w1", "[", "sy", "]"}]}], "]"}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"ans", "=", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"waist", "[", 
            RowBox[{"f1", ",", 
             RowBox[{"w1", "[", "sol", "]"}]}], "]"}], "\[Equal]", "r0"}], ",",
           "sol"}], "]"}]}], ";", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Some", " ", "solutions", " ", "can", " ", "be", " ", "imaginary"}], 
         ",", " ", 
         RowBox[{
         "one", " ", "needs", " ", "to", " ", "pick", " ", "out", " ", "real",
           " ", "solution", " ", "in", " ", "following", " ", 
          RowBox[{"loop", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"ans", "/.", 
           RowBox[{"sy", "\[Rule]", "s"}]}], "]"}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "ans", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"sy2", "=", 
           RowBox[{"sol", "/.", 
            RowBox[{"ans", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "1"}], "]"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"Element", "[", 
             RowBox[{"sy2", ",", "Reals"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"sx2", "=", 
              RowBox[{"sol", "/.", 
               RowBox[{
                RowBox[{"NSolve", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    FractionBox["1", "sol"], "+", 
                    FractionBox["1", 
                    RowBox[{"sy2", "+", 
                    FractionBox[
                    RowBox[{
                    RowBox[{"(", 
                    FractionBox[
                    RowBox[{"\[Pi]", " ", 
                    RowBox[{"w2", "^", "2"}]}], "\[Lambda]"], ")"}], "^", 
                    "2"}], 
                    RowBox[{"sy2", "-", "f2"}]]}]]}], "\[Equal]", 
                   FractionBox["1", "f2"]}], ",", "sol"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"sx2", "+", "f1"}], ">", "0"}], ",", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"res", ",", 
                 RowBox[{"{", 
                  RowBox[{"sy2", ",", 
                   RowBox[{"sx2", "+", "f1"}]}], "}"}]}], "]"}], ",", 
               "None"}], "]"}]}], ",", "\[IndentingNewLine]", "None"}], 
           "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "res", "]"}]}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Return", " ", 
       RowBox[{"{", 
        RowBox[{"sy2", ",", " ", 
         RowBox[{"d", "=", 
          RowBox[{"sy1", "+", "sx2"}]}]}], "}"}]}], "*)"}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Given", " ", "input", " ", "beam"}], ",", " ", 
     RowBox[{
     "desired", " ", "beam", " ", "waist", " ", "at", " ", "desired", " ", 
      "position", " ", "and", " ", "distance", " ", "between", " ", "two", " ",
       "lenses"}], ",", " ", 
     RowBox[{"solve", " ", "for", " ", "proper", " ", "focal", " ", 
      RowBox[{"lengths", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TwoLensFixOutput", "[", 
     RowBox[{"\[Lambda]_", ",", "r0_", ",", "m_", ",", "sy_", ",", "d_"}], 
     "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f1", ",", "f2", ",", "w1", ",", "w2", ",", "waist", ",", "i", ",", 
        "ans", ",", "sol1", ",", "sol2", ",", 
        RowBox[{"res", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"w2", "=", 
        RowBox[{"m", "*", "r0"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"w1", "[", "f2_", "]"}], ":=", 
        RowBox[{"w2", "/", 
         SqrtBox[
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", 
              FractionBox["sy", "f2"]}], ")"}], "^", "2"}], "+", 
           RowBox[{
            RowBox[{"(", 
             FractionBox[
              RowBox[{"\[Pi]", " ", 
               RowBox[{"w2", "^", "2"}]}], 
              RowBox[{"\[Lambda]", " ", "f2"}]], ")"}], "^", "2"}]}]]}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"waist", "[", 
         RowBox[{"z_", ",", "w0_"}], "]"}], ":=", 
        RowBox[{"w0", "*", 
         SqrtBox[
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"(", 
             FractionBox["z", 
              FractionBox[
               RowBox[{"\[Pi]", " ", 
                RowBox[{"w0", "^", "2"}]}], "\[Lambda]"]], ")"}], "^", 
            "2"}]}]]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ans", "=", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             FractionBox["1", 
              RowBox[{"d", "-", "sol1"}]], "+", 
             FractionBox["1", 
              RowBox[{"sy", "+", 
               FractionBox[
                RowBox[{
                 RowBox[{"(", 
                  FractionBox[
                   RowBox[{"\[Pi]", " ", 
                    RowBox[{"w2", "^", "2"}]}], "\[Lambda]"], ")"}], "^", 
                 "2"}], 
                RowBox[{"sy", "-", "sol2"}]]}]]}], "\[Equal]", 
            FractionBox["1", "sol2"]}], "&&", 
           RowBox[{
            RowBox[{"waist", "[", 
             RowBox[{"sol1", ",", 
              RowBox[{"w1", "[", "sol2", "]"}]}], "]"}], "\[Equal]", "r0"}]}],
           ",", 
          RowBox[{"{", 
           RowBox[{"sol1", ",", "sol2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"ans", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"sol1", "\[Rule]", "f1"}], ",", 
             RowBox[{"sol2", "\[Rule]", "f2"}]}], "}"}]}], "]"}], ";"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "ans", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"f1", ",", "f2"}], "}"}], "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sol1", ",", "sol2"}], "}"}], "/.", 
            RowBox[{"ans", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Element", "[", 
              RowBox[{"f1", ",", "Reals"}], "]"}], "&&", 
             RowBox[{"Element", "[", 
              RowBox[{"f2", ",", "Reals"}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"res", ",", 
              RowBox[{"{", 
               RowBox[{"f1", ",", "f2"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", "None"}], "\[IndentingNewLine]", "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "res", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Given", " ", "input", " ", "beam", " ", "waist"}], ",", " ", 

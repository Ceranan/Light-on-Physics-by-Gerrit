Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"OutputWaist", "[", 
    RowBox[{"MFD_", ",", "fc_", ",", "\[Lambda]_"}], "]"}], ":=", 
   FractionBox[
    RowBox[{"2", "\[Lambda]", "  ", "fc"}], 
    RowBox[{"\[Pi]", " ", "MFD"}]]}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "This", " ", "one", " ", "assumes", " ", "the", " ", "MFD", " ", "from", " ",
     "fiber", " ", "sits", " ", "on", " ", "the", " ", "collimator", " ", 
    "focal", " ", 
    RowBox[{"point", "."}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MaxWaistDis", "[", 
   RowBox[{"MFD_", ",", "fc_", ",", "\[Lambda]_"}], "]"}], ":=", 
  FractionBox[
   RowBox[{"2", "\[Lambda]", " ", 

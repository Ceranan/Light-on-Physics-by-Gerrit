Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"w0a", "=", ".649"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Expected output waist position from collimater (just for \
reference, the measured value could be much different):\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"OutputWaistPos", "[", 
  RowBox[{"MFD", ",", "fc", ",", "\[Lambda]", ",", "w0a"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<Measured output waist position from collimater:\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s0", "=", 
    RowBox[{"-", "200"}]}], 
   RowBox[{"(*", " ", 
    RowBox[{"fclist", "[", 
     RowBox[{"[", "laser", "]"}], "]"}], " ", "*)"}], ";"}], " ", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sx1exp", "=", 
   RowBox[{"-", "s0"}]}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Assume", " ", "the", " ", "collimater", " ", "just", " ", "sits", " ", 
     "at", " ", "the", " ", "1", "st", " ", 
     RowBox[{"lens", ".", " ", "So"}]}], " ", "-", 
    RowBox[{
    "s0", " ", "is", " ", "the", " ", "objective", " ", "distance", " ", "to",
      " ", "1", "st", " ", 
     RowBox[{"lens", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sy2exp", " ", "=", " ", "500"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Measured", " ", "distance", " ", "from", " ", "2", "nd", " ", "lens", " ",
     "to", " ", "the", " ", "plano", " ", "mirror", " ", "of", " ", 
    RowBox[{"cavity", ".", " ", "This"}], " ", "is", " ", "the", " ", "image",
     " ", "distance", " ", "of", " ", "2", "nd", " ", 
    RowBox[{"lens", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "First", " ", "input", " ", "lens", " ", "position", " ", "sx1exp"}], ",",
     " ", "sy2exp", ",", " ", 
    RowBox[{
    "dlens", " ", "as", " ", "a", " ", "rough", " ", "estimation", " ", "of", 
     " ", "focal", " ", 
     RowBox[{"lengths", "."}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TwoLensGaussianOutput", "[", 
   RowBox[{"\[Lambda]", ",", "w0a", ",", 
    RowBox[{"w2", "/", "w0a"}], ",", "sx1exp", ",", "sy2exp", ",", "dlens"}], 
   "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Then", " ", "base", " ", "on", " ", "the", " ", "above", " ", 
     "results"}], ",", " ", 
    RowBox[{
    "round", " ", "in", " ", "to", " ", "existing", " ", "focal", " ", 
     "lengths"}], ",", " ", 
    RowBox[{"re", "-", 
     RowBox[{"calculate", " ", "the", " ", "required", " ", "lens", " ", 
      RowBox[{"positions", "."}]}]}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pos", "=", 
   RowBox[{"TwoLensGaussianf", "[", 
    RowBox[{"\[Lambda]", ",", "w0a", ",", 
     RowBox[{"w2", "/", "w0a"}], ",", 
     RowBox[{"-", "150"}], ",", "175", ",", "sy2exp"}], "]"}]}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"It", " ", "returns", " ", "sx1"}], ",", " ", 
    RowBox[{"sy1", "+", 
     RowBox[{"sx2", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Distance from 1st lens to collimator:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"lens1", "=", 
  RowBox[{
   RowBox[{"pos", "[", 
    RowBox[{"[", 
     RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", "s0"}]}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<Distance between 1st and 2nd lenses:\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"lens2to1", "=", 
  RowBox[{"pos", "[", 
   RowBox[{"[", 
    RowBox[{"2", ",", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]", 

    RowBox[{"TwoLensGaussianOutput", "[", 
     RowBox[{
     "\[Lambda]_", ",", "w0_", ",", "m_", ",", "sx1_", ",", "sy2_", ",", 
      "d_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "f1", ",", "f2", ",", "w1", ",", "w2", ",", "zR", ",", "i", ",", "ans",
         ",", "sol1", ",", "sol2", ",", 
        RowBox[{"res", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"w2", "=", 
        RowBox[{"m", "*", "w0"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"zR", "[", "w_", "]"}], ":=", 
        FractionBox[
         RowBox[{"\[Pi]", " ", 
          RowBox[{"w", "^", "2"}]}], "\[Lambda]"]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ans", "=", 
        RowBox[{"NSolve", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            FractionBox["1", 
             RowBox[{
              FractionBox["1", "sol1"], "-", 
              FractionBox["1", 
               RowBox[{"sx1", "+", 
                FractionBox[
                 RowBox[{
                  RowBox[{"(", 
                   FractionBox[
                    RowBox[{"\[Pi]", " ", 
                    RowBox[{"w0", "^", "2"}]}], "\[Lambda]"], ")"}], "^", 
                  "2"}], 
                 RowBox[{"sx1", "-", "sol1"}]]}]]}]], "+", 
            FractionBox["1", 
             RowBox[{
              FractionBox["1", "sol2"], "-", 
              FractionBox["1", 
               RowBox[{"sy2", "+", 
                FractionBox[
                 RowBox[{
                  RowBox[{"(", 
                   FractionBox[
                    RowBox[{"\[Pi]", " ", 
                    RowBox[{"w2", "^", "2"}]}], "\[Lambda]"], ")"}], "^", 
                  "2"}], 
                 RowBox[{"sy2", "-", "sol2"}]]}]]}]]}], "\[Equal]", "d"}], "&&", 
          RowBox[{
           FractionBox[
            SqrtBox[
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 FractionBox["sy2", "sol2"]}], ")"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"(", 
                FractionBox[
                 RowBox[{"\[Pi]", " ", 
                  RowBox[{"w2", "^", "2"}]}], 
                 RowBox[{"\[Lambda]", " ", "sol2"}]], ")"}], "^", "2"}]}]], 
            SqrtBox[
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 FractionBox["sx1", "sol1"]}], ")"}], "^", "2"}], "+", 
              RowBox[{
               RowBox[{"(", 
                FractionBox[
                 RowBox[{"\[Pi]", " ", 
                  RowBox[{"w0", "^", "2"}]}], 
                 RowBox[{"\[Lambda]", " ", "sol1"}]], ")"}], "^", "2"}]}]]], "\[Equal]",
            "m"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"ans", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"f1", "\[Rule]", "f1"}], ",", 
             RowBox[{"f2", "\[Rule]", "f2"}]}], "}"}]}], "]"}], ";"}], "*)"}],
        "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"i", "=", "1"}], ",", 
         RowBox[{"i", "\[LessEqual]", 
          RowBox[{"Length", "[", "ans", "]"}]}], ",", 
         RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"f1", ",", "f2"}], "}"}], "=", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"sol1", ",", "sol2"}], "}"}], "/.", 
            RowBox[{"ans", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Element", "[", 
              RowBox[{"f1", ",", "Reals"}], "]"}], "&&", 
             RowBox[{"Element", "[", 
              RowBox[{"f2", ",", "Reals"}], "]"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"res", ",", 
              RowBox[{"{", 
               RowBox[{"f1", ",", "f2"}], "}"}]}], "]"}], ",", 
            "\[IndentingNewLine]", "None"}], "\[IndentingNewLine]", "]"}], 
          ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "res", "]"}]}]}], "\[IndentingNewLine]", 
     "]"}]}]}]}]], "Input",

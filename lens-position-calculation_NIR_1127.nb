   RowBox[{"\[Pi]", " ", 
    RowBox[{"MFD", "^", "2"}]}]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"OutputWaistPos", "[", 
   RowBox[{"MFD_", ",", "fc_", ",", "\[Lambda]_", ",", "w0_"}], "]"}], ":=", 
  RowBox[{"fc", "+", 
   RowBox[{"fc", "*", 
    RowBox[{"Sqrt", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"2", "*", "w0"}], "MFD"], ")"}], "^", "2"}], "-", 
      RowBox[{
       RowBox[{"(", 
        FractionBox[
         RowBox[{"\[Pi]", " ", 
          RowBox[{"w0", "^", "2"}]}], 
         RowBox[{"\[Lambda]", " ", "fc"}]], ")"}], "^", "2"}]}], "]"}], "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Given", " ", "MFD", " ", "and", " ", "output", " ", "waist", " ", 
       "w0"}], ",", " ", 
      RowBox[{"calculate", " ", "image", " ", "waist", " ", "w0", " ", 
       RowBox[{"position", "."}]}]}], " ", "*)"}]}]}]}]}], "Input",
